{$SITE_ADDRESS} {
	encode gzip zstd

	# Django: JSON API and admin
	handle /api/* {
		# Photos arrive at about 300 KB; refuse big bodies before Django writes them to disk.
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Files written by Django
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		# Not "immutable": a photo deleted by moderation must drop out of caches.
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Plan IGN tiles of the valley (data/download_tiles.py); a missing one is a 404 the map fetches from the IGN.
	handle_path /tiles/* {
		root * /srv/tiles
		# Only found tiles: a cached 404 would keep a tile on the IGN fallback after a later download.
		@found file
		header @found Cache-Control "public, max-age=2592000"
		file_server
	}

	# Frontend (built by Vite)
	handle {
		# Vite puts a hash in asset names: cache them for good, and always revalidate the page
		# that points to them, or browsers keep running the previous release after a deploy.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
