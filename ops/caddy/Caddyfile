{$SITE_ADDRESS} {
	encode gzip zstd

	# Django: JSON API and admin
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Files written by Django
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Frontend (built by Vite)
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
