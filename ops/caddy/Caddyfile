{$SITE_ADDRESS} {
	encode gzip zstd

	# Django: JSON API and admin
	handle /api/* {
		# Photos arrive at about 300 KB; refuse big bodies before Django writes them to disk.
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Files written by Django
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		# Not "immutable": a photo deleted by moderation must drop out of caches.
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Frontend (built by Vite)
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
