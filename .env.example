# Copy to .env and fill in. Never commit .env.

# Public address of the site (used by Caddy for HTTPS certificates)
SITE_ADDRESS=localhost

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,www.eaux-de-saurat.fr

POSTGRES_DB=eaux
POSTGRES_USER=eaux
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Admin pages answer only these addresses (Caddy remote_ip ranges, space-separated). Add the association's
# public IP, e.g. "private_ranges 203.0.113.7"; with private_ranges alone the admin works only on this machine.
ADMIN_ALLOWED_IPS=private_ranges

# Sign-in links are e-mailed from the association's domain mailbox (SMTP). Left empty, the e-mails are printed in
# the backend log instead (docker compose logs backend): fine for testing, not for the public site.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Eaux de Saurat <ne-pas-repondre@eaux-de-saurat.fr>
