# Copy to .env and fill in. Never commit .env.

# Public address of the site (used by Caddy for HTTPS certificates)
SITE_ADDRESS=localhost

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,www.eaux-de-saurat.fr

POSTGRES_DB=eaux
POSTGRES_USER=eaux
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Maximum distance between a photo and a station for the photo to be attached to it
STATION_ATTACH_RADIUS_M=400
